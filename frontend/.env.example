# Infinitics AI - Frontend Environment Variables
# If backend is deployed separately (e.g. Render, Railway, AWS, GCP), set full backend API URL:
# Example: VITE_API_URL=https://infinitics-backend.onrender.com/api/v1
# If deploying behind a reverse proxy on the same domain, leave empty or set to /api/v1
VITE_API_URL=
