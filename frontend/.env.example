# Infinitics AI - Frontend Environment Variables
# ================================================
#
# IMPORTANT: For Vercel deployments, set VITE_API_URL in the Vercel Dashboard:
#   Vercel → Project Settings → Environment Variables → Add:
#     Key:   VITE_API_URL
#     Value: https://your-backend.onrender.com   (NO trailing slash, NO /api/v1 suffix)
#   Then REDEPLOY — Vite bakes env vars at build time.
#
# For local development, leave VITE_API_URL empty — Vite's dev proxy handles it.
# For Render/Railway/etc backend, set the full backend URL:
#   Example: VITE_API_URL=https://ai-data-analyst-backend.onrender.com
#
VITE_API_URL=

